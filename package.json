{
  "name": "@fosferon/gc-mcp",
  "version": "1.4.0",
  "description": "Universal MCP server for Grand Central — exposes gc_daemon API as MCP tools",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "grand-central",
    "gc-daemon",
    "agent",
    "ai"
  ],
  "homepage": "https://github.com/fosferon/gc_mcp#readme",
  "bugs": "https://github.com/fosferon/gc_mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fosferon/gc_mcp.git"
  },
  "license": "MIT",
  "author": "fosferon",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gc-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node test/tools-list-no-refs.mjs && node test/strict-params.mjs && node test/long-call-timeout.mjs && node test/missing-undici.mjs",
    "test:slow": "npm run build && GC_MCP_SLOW_TESTS=1 node test/long-call-timeout.mjs",
    "prepublishOnly": "npm test",
    "start": "node dist/index.js",
    "start:http": "GC_MCP_TRANSPORT=streamable-http node dist/index.js",
    "start:all": "GC_MCP_TRANSPORT=all node dist/index.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "undici": "^7.29.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
