{
  "name": "gc-mcp",
  "version": "1.0.0",
  "description": "Universal MCP server for Grand Central — exposes gc_daemon API as MCP tools",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node test/tools-list-no-refs.mjs && node test/strict-params.mjs",
    "start": "node dist/index.js",
    "start:http": "GC_MCP_TRANSPORT=streamable-http node dist/index.js",
    "start:all": "GC_MCP_TRANSPORT=all node dist/index.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
