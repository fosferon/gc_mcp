#!/usr/bin/env bash
# Enable once per clone: git config core.hooksPath .githooks
#
# Runs the public guard over every commit being pushed, not just the working tree:
# a leak committed and later removed would otherwise still be published in history.
set -euo pipefail
top="$(git rev-parse --show-toplevel)"
guard="$top/scripts/public_guard.sh"
export PUBLIC_GUARD_EXTRA_FILE="${PUBLIC_GUARD_EXTRA_FILE:-$HOME/.config/fosferon/public-guard-extra.txt}"
export PUBLIC_GUARD_REQUIRE_EXTRA=1
remote="${1:-origin}"
zero=0000000000000000000000000000000000000000
status=0
wt=""
cleanup() { if [[ -n "$wt" ]]; then git worktree remove -f "$wt" 2>/dev/null || true; rm -rf "$wt" "$wt.log"; fi; }
trap cleanup EXIT
while read -r _lref lsha _rref rsha; do
  [[ "$lsha" == "$zero" ]] && continue                       # branch deletion
  # A remote sha we do not have (unfetched force-push target, pruned object) falls
  # back to everything not already on the remote, instead of an empty range.
  if [[ "$rsha" == "$zero" ]] || ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    range=("$lsha" --not --remotes="$remote")
  else range=("$rsha..$lsha"); fi
  commits=$(git rev-list "${range[@]}")   # a failure here aborts the push (set -e)
  for c in $commits; do
    wt=$(mktemp -d)
    git worktree add -q --detach -f "$wt" "$c"
    if ! (cd "$wt" && bash "$guard") >"$wt.log" 2>&1; then
      echo "pre-push: public guard failed on commit ${c:0:12}:"; sed 's/^/  /' "$wt.log"; status=1
    fi
    cleanup; wt=""
  done
done
exit $status
